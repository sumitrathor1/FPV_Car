[Unit]
Description=FPV Car FastAPI High-Speed Python Server
After=network.target

[Service]
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/FPV_Car/Backend
Environment="PATH=/home/azureuser/FPV_Car/Backend/venv/bin"
ExecStart=/home/azureuser/FPV_Car/Backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
